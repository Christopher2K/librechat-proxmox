# Copy to /opt/librechat/.env and adjust. install.sh generates this automatically.
# Reference: https://www.librechat.ai/docs/configuration/dotenv

UID=1000
GID=1000

# Server
HOST=0.0.0.0
PORT=3080
DOMAIN_CLIENT=http://192.168.0.10:3080   # <- set to your LAN IP / hostname
DOMAIN_SERVER=http://192.168.0.10:3080
NO_INDEX=true
TRUST_PROXY=1
SESSION_COOKIE_SECURE=false

# Admin panel
ADMIN_PANEL_PORT=3000
ADMIN_PANEL_SESSION_SECRET=change-me-min-32-chars
ADMIN_PANEL_SESSION_COOKIE_SECURE=false
ADMIN_PANEL_URL=http://192.168.0.10:3000

# Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
CREDS_KEY=change-me
CREDS_IV=change-me            # openssl rand -hex 16

# Auth
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
SESSION_EXPIRY=1000 * 60 * 15
REFRESH_TOKEN_EXPIRY=(1000 * 60 * 60 * 24) * 7

# Search (Meilisearch)
SEARCH=true
MEILI_NO_ANALYTICS=true
MEILI_MASTER_KEY=change-me

# RAG API (pgvector)
RAG_PORT=8000
VECTOR_DB_TYPE=pgvector
DB_PORT=5432
POSTGRES_DB=librechat
POSTGRES_USER=librechat
POSTGRES_PASSWORD=change-me
RAG_UPLOAD_DIR=/app/uploads

# App
APP_TITLE=LibreChat
ENDPOINTS=openAI,agents,assistants,anthropic,google
OPENAI_API_KEY=user_provided
ANTHROPIC_API_KEY=user_provided
GOOGLE_KEY=user_provided

# Uncomment and set to enable file uploads / RAG embeddings via OpenAI:
# RAG_OPENAI_API_KEY=your-key-here
